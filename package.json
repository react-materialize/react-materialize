{
  "name": "react-materialize",
  "version": "3.10.0",
  "description": "Material design components for react",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "lib"
  ],
  "scripts": {
    "test": "jest ./test --watchAll",
    "test-ci": "jest ./test --ci",
    "typecheck": "tsc -p types --noEmit",
    "storybook": "start-storybook -p 9001 -c .storybook",
    "build-storybook": "rm -rf docs && build-storybook -c .storybook -o docs",
    "build": "babel src --out-dir lib && npm run copy-types",
    "copy-types": "copyfiles -f types/components/*.d.ts lib",
    "lint": "biome check",
    "format": "biome check --write",
    "release": "npm run build && npm publish"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-materialize/react-materialize.git"
  },
  "keywords": [
    "material",
    "react",
    "materializecss",
    "react-component"
  ],
  "author": "Isaiah Peng <issaria@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/react-materialize/react-materialize/issues"
  },
  "jest": {
    "verbose": true,
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ],
    "testEnvironment": "jsdom",
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ]
  },
  "homepage": "https://github.com/react-materialize/react-materialize",
  "devDependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.9.0",
    "@babel/preset-env": "^7.9.5",
    "@babel/preset-react": "^7.9.4",
    "@biomejs/biome": "2.5.15",
    "@storybook/addon-actions": "^5.3.18",
    "@storybook/addon-info": "^5.3.18",
    "@storybook/addon-knobs": "^5.3.18",
    "@storybook/addon-notes": "^5.3.18",
    "@storybook/react": "^6.5.13",
    "@testing-library/react": "^10.4.9",
    "@types/classnames": "^2.2.10",
    "@types/react": "^17.0.30",
    "@types/react-dom": "^17.0.9",
    "babel-jest": "^27.3.1",
    "babel-loader": "^8.1.0",
    "copyfiles": "^2.4.1",
    "jest": "^27.3.1",
    "jest-watch-typeahead": "^1.0.0",
    "jsdom": "^16.4.0",
    "materialize-css": "^1.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "dependencies": {
    "classnames": "^2.2.6",
    "prop-types": "^15.7.2"
  }
}
