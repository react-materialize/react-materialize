{
  "name": "react-materialize",
  "version": "4.0.4",
  "description": "Material design components for react",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./lib/*.js": {
      "import": {
        "types": "./lib/*.d.mts",
        "default": "./lib/*.mjs"
      },
      "require": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      }
    },
    "./lib/*": {
      "import": {
        "types": "./lib/*.d.mts",
        "default": "./lib/*.mjs"
      },
      "require": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "lib"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p types --noEmit",
    "storybook": "storybook dev -p 9001",
    "build-storybook": "storybook build",
    "build": "vite build",
    "lint": "biome check",
    "format": "biome check --write",
    "changeset": "changeset"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-materialize/react-materialize.git"
  },
  "keywords": [
    "material",
    "react",
    "materializecss",
    "react-component"
  ],
  "author": "Isaiah Peng <issaria@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/react-materialize/react-materialize/issues"
  },
  "homepage": "https://github.com/react-materialize/react-materialize",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.6.8",
    "@types/classnames": "^2.2.10",
    "@types/react": "^17.0.30",
    "@types/react-dom": "^17.0.9",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "materialize-css": "^1.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "dependencies": {
    "classnames": "^2.2.6",
    "prop-types": "^15.7.2"
  }
}
